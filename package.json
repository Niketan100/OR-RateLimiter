{
  "name": "rate-limiter-oss",
  "version": "1.0.0",
  "description": "Smart, plug-and-play rate limiter with dynamic user-based tier system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "demo": "node examples/basic/demo.js",
    "benchmark": "ts-node tests/benchmarks/performance.test.ts",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "release": "npm run build && npm publish"
  },
  "keywords": [
    "rate-limiter",
    "rate-limiting",
    "throttle",
    "api-gateway",
    "ddos-protection",
    "token-bucket",
    "leaky-bucket",
    "sliding-window",
    "express-middleware",
    "redis",
    "distributed-rate-limiting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/koa": "^2.13.12",
    "@types/node": "^20.10.0",
    "express": "^4.18.2",
    "jest": "^29.7.0",
    "koa": "^2.14.2",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "express": "^4.0.0",
    "koa": "^2.0.0",
    "fastify": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "koa": { "optional": true },
    "fastify": { "optional": true }
  }
}
